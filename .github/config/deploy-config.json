      }
    },
    {
      "name": "Java",
      "targetService": "Azure App Service",
      "buildCmd": "mvn package -DskipTests -q",
      "testCmd": "mvn test -q",
      "configFiles": [
        "pom.xml"
      ],
      "sdkVersionFloor": "11",
      "markers": [
        "pom.xml",
        "build.gradle"
      ],
      "markerDepth": 0,
      "buildCmdOverrides": {
        "build.gradle": {
          "buildCmd": "gradle build -x test",
          "testCmd": "gradle test",
          "configFiles": [
            "build.gradle"
          ]
        }
      }
    },
    {
      "name": "Python",
      "targetService": "Azure App Service",
      "buildCmd": "pip install -r requirements.txt",
      "testCmd": "pytest --tb=short",
      "configFiles": [
        "requirements.txt"
      ],
      "sdkVersionFloor": "3.9",
      "markers": [
        "requirements.txt",
        "pyproject.toml"
      ],
      "markerDepth": 0
    },
    {
      "name": "Go",
      "targetService": "Azure Container Apps",
      "buildCmd": "go build ./...",
      "testCmd": "go test ./...",
      "configFiles": [
        "go.mod"
      ],
      "sdkVersionFloor": null,
      "markers": [
        "go.mod"
      ],
      "markerDepth": 0
    },
    {
