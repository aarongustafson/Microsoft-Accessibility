// // Creates an NSP with a profile and inbound access rules for the CorpNetPublic
// // and CorpNetSAW service tags, then associates the NSP with an existing Key Vault.
// // SFI: Enforces network-level isolation via NSP in 'Enforced' access mode.

// @description('Name for the Network Security Perimeter resource.')
// param nspName string

// @description('Name for the NSP profile.')
// param profileName string

// @description('Name for the NSP-to-Key Vault resource association.')
// param associationName string

// @description('Location for the NSP resources.')
// param location string

// @description('Resource ID of the Key Vault to associate with the NSP.')
// param keyVaultResourceId string

// @description('Tags to apply to all resources.')
// param tags object

// // BCP081 is expected and suppressed on every Microsoft.Network/networkSecurityPerimeters*
// // resource below: the bicep-types-az catalog currently tops out at API version
// // 2025-05-01 for the Microsoft.Network namespace, so no installed/available `az bicep`
// // has type metadata for `@2025-07-01` (nsp, profiles, profiles/accessRules,
// // resourceAssociations). The resource provider accepts the API version; deployment is
// // not blocked. Remove these suppressions once bicep-types-az publishes 2025-07-01 for
// // Microsoft.Network. Upstream catalog: https://github.com/Azure/bicep-types-az/tree/main/generated/network/microsoft.network

// #disable-next-line BCP081
// resource nsp 'Microsoft.Network/networkSecurityPerimeters@2025-07-01' = {
//   name: nspName
//   location: location
//   tags: tags
// }

// #disable-next-line BCP081
// resource nspProfile 'Microsoft.Network/networkSecurityPerimeters/profiles@2025-07-01' = {
//   parent: nsp
//   name: profileName
//   location: location
//   tags: tags
// }

// // Requires the Microsoft.Network/EnableServiceTagsInNsp subscription feature to be
// // registered; Deploy.ps1 ensures this before deployment. The same feature flag covers
// // all service-tag-based access rules below.

// // Separate rules per service tag so either can be removed independently without
// // touching the other's lifecycle.
// #disable-next-line BCP081
// resource accessRuleCorpNetPublic 'Microsoft.Network/networkSecurityPerimeters/profiles/accessRules@2025-07-01' = {
//   parent: nspProfile
//   name: 'allow-corpnet-public-inbound'
//   location: location
//   tags: tags
//   properties: {
//     direction: 'Inbound'
//     serviceTags: [
//       'CorpNetPublic'
//     ]
//   }
// }

// #disable-next-line BCP081
// resource accessRuleCorpNetSaw 'Microsoft.Network/networkSecurityPerimeters/profiles/accessRules@2025-07-01' = {
//   parent: nspProfile
//   name: 'allow-corpnet-saw-inbound'
//   location: location
//   tags: tags
//   properties: {
//     direction: 'Inbound'
//     serviceTags: [
//       'CorpNetSAW'
//     ]
//   }
// }

// // Link NSP to Key Vault (Enforced mode)
// #disable-next-line BCP081
// resource nspAssociation 'Microsoft.Network/networkSecurityPerimeters/resourceAssociations@2025-07-01' = {
//   parent: nsp
//   name: associationName
//   location: location
//   tags: tags
//   properties: {
//     privateLinkResource: {
//       id: keyVaultResourceId
//     }
//     profile: {
//       id: nspProfile.id
//     }
//     accessMode: 'Enforced'
//   }
// }

// @description('Resource ID of the Network Security Perimeter.')
// output nspResourceId string = nsp.id

// @description('Name of the Network Security Perimeter.')
// output nspName string = nsp.name

// @description('Name of the NSP profile.')
// output nspProfileName string = nspProfile.name
